
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>카페 메뉴 관리</title>
</head>
<body>

    <h1>카페 메뉴 관리</h1>

    <hr>

    <h2>메뉴 추가</h2>

    <form action="/menus/add" method="POST">

        메뉴 이름:
        <input type="text" name="name" required>

        <br><br>

        가격:
        <input type="number" name="price" min="0" required>

        <br><br>

        카테고리:
        <select name="category" required>
            <option value="">선택하세요</option>
            <option value="커피">커피</option>
            <option value="음료">음료</option>
            <option value="티">티</option>
            <option value="디저트">디저트</option>
        </select>

        <br><br>

        <button type="submit">메뉴 추가</button>

    </form>

    <hr>

    <% if (editMenu) { %>

        <h2>메뉴 수정</h2>

        <form action="/menus/update/<%= editMenu.id %>" method="POST">

            메뉴 이름:
            <input type="text" name="name"
                value="<%= editMenu.name %>" required>

            <br><br>

            가격:
            <input type="number" name="price"
                value="<%= editMenu.price %>" min="0" required>

            <br><br>

            카테고리:
            <select name="category" required>
                <option value="커피" <%= editMenu.category === "커피" ? "selected" : "" %>>커피</option>
                <option value="음료" <%= editMenu.category === "음료" ? "selected" : "" %>>음료</option>
                <option value="티" <%= editMenu.category === "티" ? "selected" : "" %>>티</option>
                <option value="디저트" <%= editMenu.category === "디저트" ? "selected" : "" %>>디저트</option>
            </select>

            <br><br>

            <button type="submit">수정 완료</button>

            <a href="/">취소</a>

        </form>

        <hr>

    <% } %>

    <h2>메뉴 목록</h2>

    <% if (menus.length === 0) { %>

        <p>등록된 메뉴가 없습니다.</p>

    <% } else { %>

        <table border="1">

            <tr>
                <th>번호</th>
                <th>메뉴 이름</th>
                <th>가격</th>
                <th>카테고리</th>
                <th>수정</th>
                <th>삭제</th>
            </tr>

            <% menus.forEach(menu => { %>

                <tr>
                    <td><%= menu.id %></td>

                    <td><%= menu.name %></td>

                    <td><%= menu.price %>원</td>

                    <td><%= menu.category %></td>

                    <td>
                        <a href="/menus/edit/<%= menu.id %>">
                            수정
                        </a>
                    </td>

                    <td>
                        <form action="/menus/delete/<%= menu.id %>"
                              method="POST">

                            <button type="submit">삭제</button>

                        </form>
                    </td>
                </tr>

            <% }) %>

        </table>

    <% } %>

</body>
</html>
